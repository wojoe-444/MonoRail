{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }]
  },
  // Grandfather named helper exports in their current files so other exports
  // still get checked for Fast Refresh. New helpers belong in separate modules.
  "overrides": [
    {
      "files": ["src/apps/email/MailContext.tsx"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["useMail"] }]
      }
    },
    {
      "files": ["src/apps/github-plus/RepoContext.tsx"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["useRepo", "useAsync"] }]
      }
    },
    {
      "files": ["src/apps/jira-plus/JiraContext.tsx"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["useJira"] }]
      }
    },
    {
      "files": ["src/apps/jira-plus/bits.tsx"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["CATEGORY_LABEL"] }]
      }
    },
    {
      "files": ["src/apps/tracker/TrackerContext.tsx"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["useTracker"] }]
      }
    },
    {
      "files": ["src/apps/tracker/components/Picker.tsx"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["useItems", "startedFill"] }]
      }
    },
    {
      "files": ["src/apps/tracker/pages/Projects.tsx"],
      "rules": {
