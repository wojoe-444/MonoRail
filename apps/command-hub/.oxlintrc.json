      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["useTopBarSlot"] }]
      }
    },
    {
      "files": ["src/components/ui/badge.tsx"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["badgeVariants"] }]
      }
    },
    {
