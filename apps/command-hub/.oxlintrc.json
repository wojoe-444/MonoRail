      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["modelsFor", "useComposerPrefs"] }]
      }
    },
    {
      "files": ["src/modules/openmetadata/tabs/semantic/malloySettings.tsx"],
      "rules": {
        "react/only-export-components": ["warn", { "allowConstantExport": true, "allowExportNames": ["openMalloySettings", "useMalloySettingsVersion", "pickMalloyFolder"] }]
      }
    },
    {
