{
  "appId": "dev.monorail.commandhub",
  "productName": "MonoRail",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "!electron/**/*.test.cjs",
    "package.json"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "deleteAppDataOnUninstall": false,
    "artifactName": "MonoRail-Setup-${version}.exe"
  },
  "portable": {
    "artifactName": "MonoRail-${version}-portable.exe"
  },
  "publish": [
    {
      "provider": "github",
      "owner": "wojoe-444",
      "repo": "MonoRail",
      "releaseType": "draft"
    }
  ],
  "asarUnpack": [
    "node_modules/@ccusage/**",
    "electron/extensions/runner.cjs"
  ]
}
