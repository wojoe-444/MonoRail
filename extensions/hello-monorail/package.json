{
  "name": "hello-monorail",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node --test",
    "pack": "npm run build && node monorail-sdk/pack.mjs",
    "version": "node -e \"const fs=require('fs'),m=JSON.parse(fs.readFileSync('monorail.json','utf8'));m.version=require('./package.json').version;fs.writeFileSync('monorail.json',JSON.stringify(m,null,2)+'\\n')\" && git add monorail.json"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
